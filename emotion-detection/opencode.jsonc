{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-v4-flash-free",
  "instructions": ["AGENTS.md"],
  "references": {
    "docs": {
      "path": "C:\\Code_Works\\Docs",
      "description": "Offline documentation for Python, OpenCV, YOLO"
    }
  },
  "command": {
    "check": {
      "template": "python -m py_compile emotion_detect.py",
      "description": "Validate syntax",
      "agent": "build"
    },
    "run": {
      "template": "python emotion_detect.py",
      "description": "Run detection script",
      "agent": "build"
    }
  },
  "lsp": {
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py"]
    }
  }
}
